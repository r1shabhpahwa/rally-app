# Copy to .env and fill in. Every value here is read at startup.

# Public address of the app. Every link in every email is built from this, so a
# wrong value produces 32 dead buttons. The app refuses to start without it.
APP_BASE_URL=https://badminton.example.com

# Dates and times are entered and displayed in this zone.
APP_TIMEZONE=America/Vancouver

# Organizer account. The password is hashed into the database on first boot and
# ignored afterwards, so you can remove it from the environment once you are in.
ORGANIZER_NAME=Your Name
ORGANIZER_EMAIL=you@example.com
ORGANIZER_PASSWORD=change-this-before-first-boot

# SMTP. TLS is one of: starttls (port 587), tls (implicit, port 465), none.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=badminton@example.com
SMTP_FROM_NAME=Badminton
SMTP_TLS=starttls
# Messages per second. Keep this at or below what your provider allows.
SMTP_RATE_PER_SEC=1

# Set only when the app sits behind a reverse proxy, so X-Forwarded-For can be
# believed for rate limiting.
TRUST_PROXY=true

# info | debug | warn | error
LOG_LEVEL=info
